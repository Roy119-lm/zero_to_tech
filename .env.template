# MinIO S3 Configuration
# Copy this file to .env and fill in your actual credentials

# Your S3 Access Key
S3_ACCESS_KEY=YOUR_ACCESS_KEY

# Your S3 Secret Key
S3_SECRET_KEY=YOUR_SECRET_KEY

# S3 Endpoint
S3_ENDPOINT=http://minio:9000

# Your S3 Bucket Name
S3_BUCKET=your-bucket-name

# ============================================================================
# PostgreSQL Database Configuration for Iceberg JDBC Catalog
# ============================================================================

# Database Host (use 'postgres' when running in Docker)
DB_HOST=postgres

# Database Port
DB_PORT=5432

# Database User
DB_USER=iceberg_user

# Database Password
DB_PASSWORD=iceberg_password
